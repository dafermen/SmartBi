{
  "name": "smartbi",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:5171": "vite --host 127.0.0.1 --port 5171",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "docs:check": "node scripts/check-doc-links.mjs",
    "docs:screenshots": "node scripts/capture-doc-screenshots.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "quality": "npm run lint && npm run test && npm run docs:check && npm run build",
    "deploy:check": "npm run quality && npm run test:e2e:production && npm audit --omit=dev",
    "deploy:production": "pwsh -NoProfile -File scripts/deploy-production.ps1",
    "deploy:bootstrap": "pwsh -NoProfile -File scripts/bootstrap-production.ps1",
    "deploy:rollback": "pwsh -NoProfile -File scripts/rollback-production.ps1",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "read-excel-file": "latest",
    "recharts": "latest",
    "remark-gfm": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
